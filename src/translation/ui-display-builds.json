            ]
          },
          "reference_values": {
            "metadata": {
              "107232240": "엘윈 숲"
            }
          }
        },
        "The Defias Uprising": {
          "contexts": {
            "metadata": [
              "31576785a7bb15b6b04003ef3e68ce65a3203661b4dc4dc6e1874bd9a13bb5ed"
            ]
